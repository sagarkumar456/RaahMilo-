rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper authentication functions
    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Users profile and device tracking
    match /users/{userId} {
      allow read, write: if signedIn();

      match /devices/{deviceId} {
        allow read, write: if signedIn();
      }
    }

    // Trips collection and points subcollection
    match /trips/{tripId} {
      allow read, write: if signedIn();

      match /points/{pointId} {
        allow read, write: if signedIn();
      }
    }

    // Device Shares: family tracking & device sharing
    match /device_shares/{shareId} {
      allow read, write: if signedIn();
    }

    // Notifications: in-app alerts and notifications
    match /notifications/{notifId} {
      allow read, write: if signedIn();
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
